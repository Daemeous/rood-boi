{
  "format": 1,
  "name": "lerp",
  "label": "Lerp",
  "category": "Math",
  "inputs": [
    {
      "name": "a",
      "type": "float3",
      "default": [
        0,
        0,
        0
      ]
    },
    {
      "name": "b",
      "type": "float3",
      "default": [
        1,
        1,
        1
      ]
    },
    {
      "name": "t",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "pin": true
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "float3"
    }
  ],
  "glsl": "result = mix(a, b, t);"
}
