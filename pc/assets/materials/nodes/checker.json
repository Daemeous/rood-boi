{
  "format": 1,
  "name": "checker",
  "label": "Checker",
  "category": "Pattern",
  "inputs": [
    {
      "name": "uv",
      "type": "float2",
      "default": [
        0,
        0
      ]
    },
    {
      "name": "size",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 64,
      "pin": true
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "float"
    }
  ],
  "glsl": "vec2 c = floor(uv / max(size, 1.0)); result = mod(c.x + c.y, 2.0);"
}
