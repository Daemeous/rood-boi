{
  "format": 1,
  "name": "remap",
  "label": "Remap",
  "category": "Math",
  "inputs": [
    {
      "name": "x",
      "type": "float",
      "default": 0
    },
    {
      "name": "lo",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "pin": true
    },
    {
      "name": "hi",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "pin": true
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "float"
    }
  ],
  "glsl": "result = mix(lo, hi, clamp(x, 0.0, 1.0));"
}
