{
  "format": 1,
  "name": "luminance",
  "label": "Luminance",
  "category": "Colour",
  "inputs": [
    {
      "name": "color",
      "type": "float3",
      "default": [
        0,
        0,
        0
      ]
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "float"
    }
  ],
  "glsl": "result = dot(color, vec3(0.299, 0.587, 0.114));"
}
