{
  "name": "Wall torch",
  "category": "Fire",
  "icon": "torch",
  "description": "A torch in a wall sconce: a strong, warm, restless flame held out from the wall. Drop it on a wall (it faces out along the surface normal).",
  "placement": { "align": "normal", "surface_offset": 0, "fixture_radius": 24 },
  "params": [
    { "key": "temperature", "label": "Colour temperature", "group": "Light", "type": "float", "default": 1700, "min": 1000, "max": 12000, "unit": "K" },
    { "key": "tint", "label": "Tint", "group": "Light", "type": "color", "default": [1, 1, 1] },
    { "key": "intensity", "label": "Intensity", "group": "Light", "type": "float", "default": 1.6, "min": 0, "max": 8 },
    { "key": "radius", "label": "Radius", "group": "Light", "type": "float", "default": 760, "min": 32, "max": 4096, "log": true },
    { "key": "reach", "label": "Out from the wall", "group": "Light", "type": "float", "default": 24, "min": 0, "max": 128, "unit": "u" },
    { "key": "flame_height", "label": "Flame height", "group": "Light", "type": "float", "default": 32, "min": -64, "max": 256, "unit": "u" },
    { "key": "flicker", "label": "Flicker amount", "group": "Animation", "type": "float", "default": 0.3, "min": 0, "max": 1 },
    { "key": "flicker_speed", "label": "Flicker speed", "group": "Animation", "type": "float", "default": 9, "min": 0.1, "max": 30, "unit": "Hz", "log": true },
    { "key": "jitter", "label": "Flame sway", "group": "Animation", "type": "float", "default": 5, "min": 0, "max": 32, "unit": "u" },
    { "key": "shadows", "label": "Casts shadows", "group": "Shadows", "type": "bool", "default": true },
    { "key": "light_size", "label": "Light size (softness)", "group": "Shadows", "type": "float", "default": 6, "min": 0.5, "max": 48, "unit": "u", "log": true },
    { "key": "glow_mode", "label": "Linked glow", "group": "Glow", "type": "enum", "options": ["Leave", "Drive", "Suppress"], "default": "Drive" },
    { "key": "glow_intensity", "label": "Glow emission", "group": "Glow", "type": "float", "default": 1, "min": 0, "max": 4 }
  ],
  "lights": [
    {
      "name": "Flame",
      "type": "point",
      "offset": [0, "-flame_height", "reach"],
      "color": "kelvin(temperature) * tint",
      "intensity": "intensity",
      "radius": "radius",
      "shadows": "shadows",
      "light_size": "light_size",
      "flicker": "flicker",
      "flicker_speed": "flicker_speed",
      "jitter": "jitter"
    }
  ],
  "glow": {
    "mode": "glow_mode",
    "scale": "glow_intensity",
    "suggest": { "hue": "warm", "min_size": 4.5, "priority": 1 }
  }
}
