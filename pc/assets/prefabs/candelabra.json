{
  "name": "Candelabra",
  "category": "Fire",
  "icon": "candelabra",
  "description": "Three candles on one stand: three flickering flames, independently animated.",
  "placement": { "align": "up", "surface_offset": 0, "fixture_radius": 20 },
  "params": [
    { "key": "temperature", "label": "Colour temperature", "group": "Light", "type": "float", "default": 1900, "min": 1000, "max": 12000, "unit": "K" },
    { "key": "tint", "label": "Tint", "group": "Light", "type": "color", "default": [1, 1, 1] },
    { "key": "intensity", "label": "Intensity (each)", "group": "Light", "type": "float", "default": 0.45, "min": 0, "max": 4 },
    { "key": "radius", "label": "Radius", "group": "Light", "type": "float", "default": 400, "min": 32, "max": 2048, "log": true },
    { "key": "height", "label": "Flame height", "group": "Light", "type": "float", "default": 48, "min": 0, "max": 256, "unit": "u" },
    { "key": "spread", "label": "Arm spread", "group": "Light", "type": "float", "default": 16, "min": 0, "max": 128, "unit": "u" },
    { "key": "flicker", "label": "Flicker amount", "group": "Animation", "type": "float", "default": 0.18, "min": 0, "max": 1 },
    { "key": "flicker_speed", "label": "Flicker speed", "group": "Animation", "type": "float", "default": 7, "min": 0.1, "max": 30, "unit": "Hz", "log": true },
    { "key": "shadows", "label": "Casts shadows", "group": "Shadows", "type": "bool", "default": true },
    { "key": "light_size", "label": "Light size (softness)", "group": "Shadows", "type": "float", "default": 2, "min": 0.5, "max": 32, "unit": "u", "log": true }
  ],
  "lights": [
    { "name": "Left flame", "type": "point", "offset": ["-spread", "-height", 0], "color": "kelvin(temperature) * tint", "intensity": "intensity", "radius": "radius", "shadows": "shadows", "light_size": "light_size", "flicker": "flicker", "flicker_speed": "flicker_speed", "jitter": 1.5, "phase": 0.1 },
    { "name": "Centre flame", "type": "point", "offset": [0, "-height - 6", 0], "color": "kelvin(temperature) * tint", "intensity": "intensity", "radius": "radius", "shadows": "shadows", "light_size": "light_size", "flicker": "flicker", "flicker_speed": "flicker_speed", "jitter": 1.5, "phase": 0.4 },
    { "name": "Right flame", "type": "point", "offset": ["spread", "-height", 0], "color": "kelvin(temperature) * tint", "intensity": "intensity", "radius": "radius", "shadows": "shadows", "light_size": "light_size", "flicker": "flicker", "flicker_speed": "flicker_speed", "jitter": 1.5, "phase": 0.7 }
  ]
}
