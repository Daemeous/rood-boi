#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
// Path-traced indirect light, shadow visibility, baked-light visibility,
// light from the glows (small spherical area lights, shadowed when glow
// shadows are on) and the lighting signature per GI pixel (ptgi.c's trace pass, with
// hardware ray queries instead of the CPU-built BVH).
layout(local_size_x = 8, local_size_y = 8) in;
#include "rt_paths.glsl"
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy), size = imageSize(gi_out);
    if (any(greaterThanEqual(g, size))) return;
    vec4 pw = imageLoad(position_in, g);
    if (pw.w < 0.5) {
        imageStore(gi_out, g, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(extra_out, g, vec4(1.0, 0.0, 0.0, 0.0));
        imageStore(signature_out, g, uvec4(0u));
        imageStore(hit_out, g, vec4(0.0));
        return;
    }
    vec3 p = pw.xyz, n = imageLoad(normal_in, g).xyz;
    float z = distance(p, eye);
    rng = uint(g.x) * 1973u + uint(g.y) * 9277u + frame * 26699u;
    float lift = 2.0 + z * 0.002; // off the surface, more with distance (depth precision)
    if (trace_debug == 1) { imageStore(gi_out, g, vec4(n * 0.5 + 0.5, 1.0)); return; }
    if (trace_debug == 3) { imageStore(gi_out, g, vec4(fract(p / 256.0), 1.0)); return; }
    if (trace_debug == 2) {
        float t; int hit; vec2 bc;
        bool any_ = trace(p + n * lift, cosine_direction(n), 8192.0, false, n, 16.0, t, hit, bc);
        imageStore(gi_out, g, any_ ? (t < 8.0 ? vec4(1, 0, 0, 1) : vec4(vec3(t / 1024.0), 1.0)) : vec4(0, 0, 1, 1));
        return;
    }
    vec3 total = vec3(0.0);
    float hit_sum = 0.0, hit_count = 0.0;
    float vis = shadows != 0 ? visibility_with_sun(p + n * lift, n) : 1.0;
    for (int r = 0; r < (indirect != 0 ? rays : 0); r++) {
        vec3 o = p + n * lift, nrm = n, throughput = vec3(1.0);
        for (int b = 0; b < bounces; b++) {
            vec3 d = cosine_direction(nrm);
            float t; int hit; vec2 bc;
            if (!trace(o, d, 8192.0, false, nrm, b == 0 ? 16.0 : 0.0, t, hit, bc)) {
                if (env_sky_on()) { // left the room: the sky's light (NRD: a far hit)
                    total += throughput * env_sky(d);
                    if (b == 0) { hit_sum += 4096.0; hit_count += 1.0; }
                }
                break;
            }
            if (b == 0) { hit_sum += t; hit_count += 1.0; }
            Tri tri = tri_at(hit);
            vec3 y = o + d * t;
            vec3 ny = normalize(cross(tri.b.xyz - tri.a.xyz, tri.c.xyz - tri.a.xyz));
            if (dot(ny, d) > 0.0) ny = -ny;
            vec3 vc = vertex_rgb(tri.a.w) * (1.0 - bc.x - bc.y) + vertex_rgb(tri.b.w) * bc.x + vertex_rgb(tri.c.w) * bc.y;
            vec3 albedo = vc;
            if ((tri.info.w & 1u) != 0u) {
                uint c = surface_texel(tri, bc);
                albedo = vec3(c & 31u, (c >> 5) & 31u, (c >> 10) & 31u) / 31.0;
            }
            vec3 baked = (tri.info.w & 2u) != 0u ? albedo : min(albedo * vc * 2.0, 1.0);
            total += throughput * (albedo * (direct(y + ny * 0.5, ny) + sun_light(y + ny * 0.5, ny)) + baked * baked_bounce);
            throughput *= albedo;
            o = y + ny * 1.0; nrm = ny;
        }
    }
    vec3 gi = total / float(max(rays, 1));
    vec3 glow = emitted(p + n * lift, n);
    if (any(isnan(gi)) || any(isinf(gi))) gi = vec3(0.0);
    if (isnan(vis) || isinf(vis)) vis = 1.0;
    imageStore(gi_out, g, vec4(gi, vis));
    imageStore(hit_out, g, vec4(hit_count > 0.0 ? min(hit_sum / hit_count, 65000.0) : 0.0));

    // Characters and props carry the game's own per-frame lighting, not the
    // room's baked light: only room surfaces take its visibility.
    bool moving_surface = pw.w > 1.5;
    float bvis = baked_shadows != 0 && !moving_surface ? baked_visibility(p + n * lift, n, n) : 1.0;
    if (ao_radius > 0.0 && !moving_surface) bvis *= traced_ao(p + n * lift, n);
    if (isnan(bvis) || isinf(bvis)) bvis = 1.0;
    if (any(isnan(glow)) || any(isinf(glow))) glow = vec3(0.0);
    imageStore(extra_out, g, vec4(bvis, glow));
    uint sig = lighting_signature(p + n * lift, n) | sun_signature(p + n * lift, n);
    imageStore(signature_out, g, uvec4(sig | (touched ? 0x80000000u : 0u)));
}
