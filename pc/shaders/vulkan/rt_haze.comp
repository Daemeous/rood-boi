#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
// Volumetric haze, step 1: per froxel (a cell of the view frustum: GX x GY
// screen cells, GZ logarithmic depth slices, stored as GZ tiles side by side
// in a 2D image) the medium's light scattered toward the eye per unit length
// (rgb: scattering x the light arriving + its own emission) and its
// extinction (a), x 1000 (half floats), a + 1 (1: valid history). Each
// froxel samples a point in its cell (blue-noise jitter, R2 offsets per frame),
// picks one light or glow in proportion to its unshadowed light there and
// traces one shadow ray, and the sun one more (its disc, its own phase
// weight: shafts through arches and branches), then blends with its
// reprojected history, so the haze is smooth and stable and each froxel
// holds the medium's average over its cell: a fog layer or a volume's edge
// thinner than a slice comes out as a smooth gradient, never as slices or
// steps (the integrate pass no longer samples the medium at fixed points).
// It depends only on
// the camera, never on what is drawn, so effects and particles cannot cut
// holes in it. Froxels where the medium cannot be (medium_maybe) skip it.
layout(local_size_x = 8, local_size_y = 8) in;
#define LIGHT_LIST 10
#include "rt_lights.glsl"
#include "rt_common.glsl"
layout(std140, binding = 4) uniform Haze {
    ivec4 grid; // GX, GY, GZ, history valid
    vec4 depth_range; // znear, log(zfar / znear), display w, h
    vec4 projection; // hx, hh, ofx, ofy
    vec4 inverse_rotation[3]; // view -> world (columns)
    vec4 camera_translation; // xyz; w: history weight of new samples
    vec4 previous_rotation[3]; // previous world -> view (rows), w: translation
    vec4 previous_projection; // hx, hh, ofx, ofy
    vec4 previous_range; // znear, log(zfar / znear)
    vec4 medium_[166]; // the room's medium (medium.glsl, atmosphere.h)
} h;
#define MEDIUM(i) h.medium_[i]
layout(binding = 11) uniform sampler3D medium_tex; // the medium's texture (atmosphere.h pc_medium_texture)
#define MEDIUM_TEX medium_tex
#include "medium.glsl"
layout(binding = 5, rgba16f) uniform writeonly image2D scatter_out;
layout(binding = 6) uniform sampler2D history;
float slice_z(float k) { return h.depth_range.x * exp(k / float(h.grid.z) * h.depth_range.y); }
vec3 world_of(vec3 cell) { // cell coordinates (x, y in screen cells, z in slices) -> world
    float z = slice_z(cell.z);
    vec2 s = cell.xy / vec2(h.grid.xy) * h.depth_range.zw - h.projection.zw;
    vec3 view = vec3(s.x * z / h.projection.x, s.y * z / h.projection.y, z);
    mat3 inv = mat3(h.inverse_rotation[0].xyz, h.inverse_rotation[1].xyz, h.inverse_rotation[2].xyz);
    return inv * (view - h.camera_translation.xyz);
}
// Bilinear in the tile, linear between slices (cell coordinates).
vec4 sample_history(vec3 c) {
    vec2 tile = vec2(h.grid.xy);
    float k = clamp(c.z - 0.5, 0.0, float(h.grid.z - 1));
    float k0 = floor(k), f = k - k0, k1 = min(k0 + 1.0, float(h.grid.z - 1));
    vec2 xy = clamp(c.xy, vec2(0.5), tile - 0.5);
    vec2 size = vec2(textureSize(history, 0));
    vec4 a = texture(history, (xy + vec2(k0 * tile.x, 0.0)) / size);
    vec4 b = texture(history, (xy + vec2(k1 * tile.x, 0.0)) / size);
    return mix(a, b, f);
}
// A column glow's shadow ray for the last source_light (rt_lights.glsl
// emitter_shadow: to its core, up to its side); reach < 0: the ray to the sample.
vec3 haze_shadow_dir; float haze_shadow_reach;
vec3 source_light(int i, vec3 x, out vec3 l, out float d) {
    vec3 centre; vec4 pos; vec3 col;
    haze_shadow_reach = -1.0;
    if (i < light_count) {
        centre = lpos(i).xyz; pos = lpos(i); col = lcol(i).rgb;
        if (lcol(i).w > 1.5) centre += lright(i).xyz * (rand() * 2.0 - 1.0) + lup(i).xyz * (rand() * 2.0 - 1.0);
        else centre += (vec3(rand(), rand(), rand()) - 0.5) * 2.0 * point_size(i);
    } else {
        int e = i - light_count; pos = emitter_pos[e]; col = emitter_col[e].rgb * fog_glow;
        float a = rand(), b = rand(), c = rand();
        vec4 r = vec4(a, b, c, rand());
        centre = emitter_sample(e, r); // its sphere or column (rt_lights.glsl)
        if (u.emitter_shape_[e].w > 0.0)
            haze_shadow_reach = max(emitter_shadow(e, x, r, haze_shadow_dir), 0.0);
    }
    vec3 to = centre - x; d = length(to); l = to / max(d, 1e-3);
    float f = clamp(d / pos.w, 0.0, 1.0);
    float a = (1.0 - f * f) * (1.0 - f * f);
    if (i < light_count) a *= light_shape(lcol(i).w, lpos(i).xyz, ldir(i), lright(i), lup(i), x, l);
    return col * a;
}
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= h.grid.x * h.grid.z || g.y >= h.grid.y) return;
    int k = g.x / h.grid.x;
    ivec3 cell = ivec3(g.x - k * h.grid.x, g.y, k);
    // Every random choice (the jitter, the light picked, the point on it, the
    // sun's and the sky's rays) cycles through CYCLE frames: a froxel's
    // samples are a fixed, stratified set the history averages, so a still
    // picture converges and stays still (a random sequence never settled:
    // the haze shimmered with the camera, the fog and the wind all still).
    const uint CYCLE = 16u;
    uint phase = frame % CYCLE;
    rng = uint(g.x) * 1973u + uint(g.y) * 9277u + phase * 26699u;
    // Blue-noise jitter in the cell: interleaved gradient noise over the
    // froxels, shifted by the R3 sequence each frame (stratified over time).
    vec3 r3 = fract(vec3(0.8191725, 0.6710436, 0.5497005) * float(phase));
    vec2 p = vec2(g) + vec2(float(k) * 5.3, float(k) * 2.9);
    vec3 jitter = fract(vec3(medium_ign(p), medium_ign(p + vec2(47.0, 17.0)), medium_ign(p + vec2(13.0, 59.0))) + r3);
    vec3 x = world_of(vec3(cell) + jitter);
    vec3 centre = world_of(vec3(cell) + 0.5);
    vec3 eye_ = -(mat3(h.inverse_rotation[0].xyz, h.inverse_rotation[1].xyz, h.inverse_rotation[2].xyz) * h.camera_translation.xyz);
    vec3 dir = normalize(x - eye_);
    vec3 light = vec3(0.0);
    bool inside = medium_maybe(x) || medium_maybe(centre);
    float g_ = medium_g();
    // Every light and glow (any number): one picked in proportion to its
    // unshadowed light here, in one pass (weighted reservoir sampling).
    int sources = light_count + emitter_count;
    if (inside && sources > 0) {
        float all_ = 0.0, w_pick = 0.0; int pick = -1;
        for (int i = 0; i < sources; i++) {
            vec3 pos = i < light_count ? lpos(i).xyz : emitter_pos[i - light_count].xyz;
            float r = i < light_count ? lpos(i).w : emitter_pos[i - light_count].w;
            vec3 col = i < light_count ? lcol(i).rgb : emitter_col[i - light_count].rgb * fog_glow;
            float f = clamp(distance(pos, x) / r, 0.0, 1.0);
            float w = (1.0 - f * f) * (1.0 - f * f) * dot(col, vec3(0.299, 0.587, 0.114));
            if (w <= 0.0) continue;
            all_ += w;
            if (rand() * all_ < w) { pick = i; w_pick = w; }
        }
        if (pick >= 0) {
            int i = pick;
            vec3 l; float d, th; int hit; vec2 bc;
            vec3 c = source_light(i, x, l, d);
            // transient effects' light is never shadowed (glow_casts)
            bool column = haze_shadow_reach >= 0.0; // a column glow's side: to its core, up to the side
            vec3 sl = column ? haze_shadow_dir : l;
            if ((i >= light_count && !glow_casts_shadow(i - light_count)) || (column && haze_shadow_reach <= 0.0)
                || !trace(x, sl, column ? haze_shadow_reach : d - 2.0, true, sl, 0.0, th, hit, bc))
                light = c * (all_ / w_pick) * medium_phase(dot(dir, l), g_);
        }
    }
    // The sun (or moon): one ray to a point of its disc, stratified like
    // the jitter; past every blocker (arches, branches, the characters) the
    // haze is lit: shafts.
    if (inside && env_sun_on()) {
        vec2 u2 = fract(vec2(medium_ign(p + vec2(71.0, 3.0)), medium_ign(p + vec2(5.0, 83.0)))
                        + fract(vec2(0.7548777, 0.5698403) * float(phase)));
        vec3 l = env_sun_sample(u2.x, u2.y);
        float th; int hit; vec2 bc;
        bool lit = env_sun_col.w < 0.5 || !trace(x, l, ENV_SUN_DISTANCE, true, l, 0.0, th, hit, bc);
        light += env_sun_col.rgb * medium_phase(dot(dir, l), g_) * medium_sun_visibility(lit ? 1.0 : 0.0);
    }
    // The sky: one ray in a direction over the sphere (stratified the same
    // way); what blocks it (canopies, arches, walls) occludes it, so the air
    // under cover stays dark and the shafts keep their contrast.
    if (inside && env_sky_on() && MEDIUM(5).w > 0.0) {
        vec2 u2 = fract(vec2(medium_ign(p + vec2(23.0, 41.0)), medium_ign(p + vec2(67.0, 29.0)))
                        + fract(vec2(0.5698403, 0.7548777) * float(phase)));
        float z = 1.0 - 2.0 * u2.x, s = sqrt(max(1.0 - z * z, 0.0)), a = 6.2831853 * u2.y;
        vec3 d = vec3(s * cos(a), z, s * sin(a));
        float th; int hit; vec2 bc;
        if (!trace(x, d, ENV_SUN_DISTANCE, true, d, 0.0, th, hit, bc))
            light += env_sky(d) * MEDIUM(5).w * medium_phase(dot(dir, d), g_);
    }
    if (any(isnan(light)) || any(isinf(light))) light = vec3(0.0);
    // History: where this froxel's centre was in the previous view.
    float weight = 1.0;
    vec4 previous = vec4(0.0);
    if (h.grid.w != 0) {
        vec3 v = vec3(dot(h.previous_rotation[0].xyz, centre) + h.previous_rotation[0].w,
            dot(h.previous_rotation[1].xyz, centre) + h.previous_rotation[1].w,
            dot(h.previous_rotation[2].xyz, centre) + h.previous_rotation[2].w);
        if (v.z > 1.0) {
            vec2 s = vec2(h.previous_projection.x * v.x / v.z, h.previous_projection.y * v.y / v.z) + h.previous_projection.zw;
            vec3 c = vec3(s / h.depth_range.zw * vec2(h.grid.xy),
                log(v.z / h.previous_range.x) / h.previous_range.y * float(h.grid.z));
            if (all(greaterThanEqual(c, vec3(0.0))) && all(lessThan(c, vec3(h.grid.xyz)))) {
                previous = sample_history(c);
                // a long history while still (the cycle's samples averaged), a short one
                // while the camera moves (no smearing): by how far the froxel moved, in cells
                float moved = length(c - (vec3(cell) + 0.5));
                if (!any(isnan(previous)) && previous.a > 0.5)
                    weight = mix(h.camera_translation.w, max(h.camera_translation.w, 0.3), smoothstep(0.15, 1.5, moved));
            }
        }
    }
    vec3 scatter_ = vec3(0.0), emit_ = vec3(0.0);
    float extinction = inside ? medium_at(x, scatter_, emit_) : 0.0;
    vec4 here = extinction > 0.0 ? vec4((scatter_ * light + emit_) * 1000.0, extinction * 1000.0) : vec4(0.0);
    if (any(isnan(here)) || any(isinf(here))) here = vec4(0.0);
    vec4 blended = mix(vec4(previous.rgb, max(previous.a - 1.0, 0.0)), here, weight);
    imageStore(scatter_out, g, vec4(blended.rgb, blended.a + 1.0));
}
