#version 460
#extension GL_GOOGLE_include_directive : require
// Probe GI at GI resolution without a path-traced result (Vulkan frames
// whose lights use shadow maps, or GPUs without ray tracing): each GI
// pixel's surface from the G-buffer (rt_surface.comp's reconstruction,
// without the movers' motion), and the probe field's irradiance there. The
// present upsamples it as it does the traced result (joint bilateral on the
// positions and normals), so the field costs lookups per GI pixel, not per
// display pixel.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std140, binding = 0) uniform Surface {
    ivec4 rect; // display x, y, w, h in VRAM pixels
    ivec4 scale_; // target pixels per VRAM pixel
    vec4 gi_scale_; // GI pixels per display pixel
    vec4 projection_; // H (narrowed for widescreen), H
    vec4 screen_offset_;
    vec4 inverse_rotation_[3]; // columns
    vec4 normal_to_world_[3]; // columns
    vec4 camera_translation_;
    vec4 eye_;
} u;
#define PROBE_SAMPLING
layout(binding = 13) uniform sampler2D probe_irradiance;
layout(binding = 14) uniform sampler2D probe_depth;
layout(binding = 15) uniform sampler2D probe_data;
#include "probe_volume.glsl"
#include "probe_common.glsl"
layout(binding = 16) uniform sampler2D normal_tex; // view normal * 0.5 + 0.5, a = lit surface
layout(binding = 17) uniform sampler2D depth_tex; // SZ / 65536
layout(binding = 4, rgba32f) uniform writeonly image2D position_out; // world xyz, w 1 = surface, 2 = moving
layout(binding = 5, rgba16f) uniform writeonly image2D normal_out;
layout(binding = 6, rgba16f) uniform writeonly image2D irradiance_out; // rgb, a 1 (no traced visibility)
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy), size = imageSize(position_out);
    if (any(greaterThanEqual(g, size))) return;
    int scale = u.scale_.x;
    vec2 display = (vec2(g) + 0.5) / u.gi_scale_.xy;
    ivec2 q = ivec2((vec2(u.rect.xy) + display) * float(scale));
    q = ivec2(q.x % (1024 * scale), q.y % (512 * scale));
    vec4 nn = texelFetch(normal_tex, q, 0);
    float z = texelFetch(depth_tex, q, 0).r * 65536.0;
    if (nn.a < 0.5 || z < 0.5 || z >= 65535.0) {
        imageStore(position_out, g, vec4(0.0));
        imageStore(normal_out, g, vec4(0.0));
        imageStore(irradiance_out, g, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    vec2 s = display - u.screen_offset_.xy;
    vec3 view = vec3(s.x * z / u.projection_.x, s.y * z / u.projection_.y, z);
    mat3 inverse_rotation = mat3(u.inverse_rotation_[0].xyz, u.inverse_rotation_[1].xyz, u.inverse_rotation_[2].xyz);
    mat3 normal_to_world = mat3(u.normal_to_world_[0].xyz, u.normal_to_world_[1].xyz, u.normal_to_world_[2].xyz);
    vec3 p = inverse_rotation * (view - u.camera_translation_.xyz);
    vec3 n = normalize(normal_to_world * normalize(nn.xyz * 2.0 - 1.0));
    imageStore(position_out, g, vec4(p, nn.a <= 0.9 ? 2.0 : 1.0));
    imageStore(normal_out, g, vec4(n, 0.0));
    vec3 irradiance = probe_irradiance_at(p, n, normalize(p - u.eye_.xyz));
    if (any(isnan(irradiance))) irradiance = vec3(0.0);
    imageStore(irradiance_out, g, vec4(irradiance, 1.0));
}
