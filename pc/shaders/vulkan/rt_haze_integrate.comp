#version 450
#extension GL_GOOGLE_include_directive : require
// Volumetric haze, step 2: integrate each screen cell's column of froxels
// front to back, storing per slice the light scattered toward the eye and
// the transmittance up to that slice's far edge. Each froxel (step 1) holds
// the medium's average over its cell (light scattered toward the eye per
// unit length, extinction; jittered samples blended over frames), so a
// slice is one Beer-Lambert step with them: no fixed sample points, no
// slicing. The medium's limits (medium.glsl) apply: the least transmittance,
// the soft cap on the light. The present pass samples it at each pixel's
// depth: colour * transmittance + light.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std140, binding = 0) uniform Integrate {
    ivec4 grid; // GX, GY, GZ
    vec4 depth_range; // znear, log(zfar / znear), display w, h
    vec4 projection; // hx, hh, ofx, ofy
    vec4 inverse_rotation[3];
    vec4 camera_translation;
    vec4 room_lo, room_hi;
    vec4 medium_[166]; // the room's medium (medium.glsl, atmosphere.h)
} u;
#define MEDIUM(i) u.medium_[i]
#include "medium.glsl"
layout(binding = 1, rgba16f) uniform readonly image2D scatter;
layout(binding = 2, rgba16f) uniform writeonly image2D integrated; // rgb scattered light, a transmittance
float slice_z(float k) { return u.depth_range.x * exp(k / float(u.grid.z) * u.depth_range.y); }
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= u.grid.x || g.y >= u.grid.y) return;
    vec2 s = (vec2(g) + 0.5) / vec2(u.grid.xy) * u.depth_range.zw - u.projection.zw;
    vec3 view_dir = vec3(s.x / u.projection.x, s.y / u.projection.y, 1.0); // per unit of view depth
    mat3 inv = mat3(u.inverse_rotation[0].xyz, u.inverse_rotation[1].xyz, u.inverse_rotation[2].xyz);
    // World distance per unit of view depth (the GTE view matrix is scaled,
    // not orthonormal).
    float stretch = length(inv * view_dir);
    vec3 eye = -(inv * u.camera_translation.xyz), dir = normalize(inv * view_dir);
    vec3 light = vec3(0.0);
    float transmittance = 1.0, z0 = 0.0;
    for (int k = 0; k < u.grid.z; k++) {
        float z1 = slice_z(float(k + 1));
        // A 3 x 3 tent over the slice's neighbouring cells and a 1-2-1 one over
        // its neighbouring slices: what the jittered samples leave of the cell
        // grid blurs away (a few display pixels), in depth too.
        vec4 f = vec4(0.0);
        for (int dz = -1; dz <= 1; dz++) {
            int kz = clamp(k + dz, 0, u.grid.z - 1);
            float wz = dz == 0 ? 0.5 : 0.25;
            for (int dy = -1; dy <= 1; dy++)
                for (int dx = -1; dx <= 1; dx++) {
                    ivec2 c = clamp(g + ivec2(dx, dy), ivec2(0), u.grid.xy - 1);
                    vec4 t = imageLoad(scatter, ivec2(c.x + kz * u.grid.x, c.y));
                    f += (any(isnan(t)) ? vec4(0.0, 0.0, 0.0, 1.0) : t) * float((2 - abs(dx)) * (2 - abs(dy))) * (wz / 16.0);
                }
        }
        float extinction = max(f.a - 1.0, 0.0) * 0.001, len = (z1 - z0) * stretch;
        if (extinction > 1e-9 && !any(isnan(f))) {
            float step_ = medium_step(extinction, len, transmittance);
            light += transmittance * max(f.rgb, vec3(0.0)) * 0.001 * ((1.0 - step_) / extinction);
            transmittance *= step_;
        }
        imageStore(integrated, ivec2(g.x + k * u.grid.x, g.y), vec4(medium_limit_light(light), transmittance));
        z0 = z1;
    }
}
