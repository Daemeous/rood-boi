#version 450
#extension GL_GOOGLE_include_directive : require
// Volumetric haze, step 2: integrate each screen cell's column of froxels
// front to back through the room's medium (medium.glsl: the uniform haze,
// the ground fog with its drifting noise, the fog volumes; two fixed points
// per slice, Beer-Lambert between them), storing per slice the light
// scattered toward the eye and the transmittance up to that slice's far
// edge. The scattered light is the froxel's in-scattered light (step 1,
// per unit of scattering) times the medium's scattering colour, plus what
// the medium adds by itself (its fill light, the sky's light). The present
// pass samples it at each pixel's depth: colour * transmittance + light.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std140, binding = 0) uniform Integrate {
    ivec4 grid; // GX, GY, GZ
    vec4 depth_range; // znear, log(zfar / znear), display w, h
    vec4 projection; // hx, hh, ofx, ofy
    vec4 inverse_rotation[3];
    vec4 camera_translation;
    vec4 room_lo, room_hi;
    vec4 medium_[88]; // the room's medium (medium.glsl, atmosphere.h)
} u;
#define MEDIUM(i) u.medium_[i]
#include "medium.glsl"
layout(binding = 1, rgba16f) uniform readonly image2D scatter;
layout(binding = 2, rgba16f) uniform writeonly image2D integrated; // rgb scattered light, a transmittance
float slice_z(float k) { return u.depth_range.x * exp(k / float(u.grid.z) * u.depth_range.y); }
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= u.grid.x || g.y >= u.grid.y) return;
    vec2 s = (vec2(g) + 0.5) / vec2(u.grid.xy) * u.depth_range.zw - u.projection.zw;
    vec3 view_dir = vec3(s.x / u.projection.x, s.y / u.projection.y, 1.0); // per unit of view depth
    mat3 inv = mat3(u.inverse_rotation[0].xyz, u.inverse_rotation[1].xyz, u.inverse_rotation[2].xyz);
    // World distance per unit of view depth (the GTE view matrix is scaled,
    // not orthonormal).
    float stretch = length(inv * view_dir);
    vec3 eye = -(inv * u.camera_translation.xyz), dir = normalize(inv * view_dir);
    // Where along the ray the medium can be (the rest is skipped).
    float far_ = slice_z(float(u.grid.z)) * stretch;
    vec2 span = medium_span(eye, dir, far_);
    vec3 light = vec3(0.0);
    float transmittance = 1.0, z0 = 0.0;
    for (int k = 0; k < u.grid.z; k++) {
        float z1 = slice_z(float(k + 1));
        float a = max(z0 * stretch, span.x), b = min(z1 * stretch, span.y); // the slice's part of the span
        if (b > a) {
            vec3 l = imageLoad(scatter, ivec2(g.x + k * u.grid.x, g.y)).rgb;
            float half_ = (b - a) * 0.5;
            for (int j = 0; j < 2; j++) {
                vec3 scatter_, emit;
                float extinction = medium_at(eye + dir * (a + half_ * (float(j) + 0.5)), scatter_, emit);
                if (extinction <= 0.0) continue;
                float step_ = exp(-extinction * half_);
                light += transmittance * (scatter_ * l + emit) * ((1.0 - step_) / extinction);
                transmittance *= step_;
            }
        }
        imageStore(integrated, ivec2(g.x + k * u.grid.x, g.y), vec4(light, transmittance));
        z0 = z1;
    }
}
